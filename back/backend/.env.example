# ── APIs ──────────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key
MISTRAL_API_KEY=your_mistral_api_key          # STT (sinon /converse en erreur)
GEMINI_API_KEY=your_gemini_api_key

# ── Agent (edge function) ─────────────────────────────────────────────
AURA_AGENT_URL=https://<project>.supabase.co/functions/v1/aura-agent
AURA_AGENT_TOKEN=your_agent_token

# ── Supabase ──────────────────────────────────────────────────────────
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=eyJ...
# SERVEUR uniquement (jamais sur le device) — appairage + push live :
SUPABASE_SERVICE_ROLE_KEY=eyJ...              # Dashboard > Settings > API > service_role
SUPABASE_JWT_SECRET=...                        # Dashboard > Settings > API > JWT Secret (legacy)

# ── Réglages facilement modifiables ───────────────────────────────────
# Seuil de vérification du locuteur (0-1). Plus BAS = accepte plus facilement
# le propriétaire (utile si l'enrôlement score bas). Défaut 0.25.
SPEAKER_THRESHOLD=0.25
# Exiger que la commande vienne du locuteur enrôlé ? 1 = oui (sécurité), 0 = répond à tous.
VERIFY_SPEAKER_ENFORCE=1
