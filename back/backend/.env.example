# ═══════════════════════════════════════════════════════════════════
#  Backend CLOUD — détient TOUS les secrets (jamais sur le device).
# ═══════════════════════════════════════════════════════════════════

# Services IA / voix
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key
MISTRAL_API_KEY=your_mistral_api_key
GEMINI_API_KEY=your_gemini_api_key

# Agent Supabase
AURA_AGENT_URL=https://xxxx.supabase.co/functions/v1/aura-agent
AURA_AGENT_TOKEN=your_agent_token

# Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# ── Devices (Raspberry Pi) ──────────────────────────────────────────
# Token partagé que les devices présentent (header X-Device-Token) pour
# accéder aux routes /api/device/*. Si vide, la vérification est désactivée.
# En production : remplacer par une table devices (token unique par device).
DEVICE_TOKEN=
