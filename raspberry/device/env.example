# ════════════════════════════════════════════════════════════════════════
# Config de l'enceinte — à copier dans ~/.aura/env sur le Raspberry Pi.
# Le device le lit au démarrage (plus besoin d'exporter à chaque boot).
#   mkdir -p ~/.aura && cp device/env.example ~/.aura/env   (puis éditer)
# Format : KEY=VALUE (une par ligne). Décommente/édite ce que tu veux.
# ════════════════════════════════════════════════════════════════════════

# ── Obligatoire ───────────────────────────────────────────────────────
CLOUD_BACKEND_URL=https://backend-aura.hallia.ai
DEVICE_TOKEN=a2fcdb64f389be73caaa6405093ff26ced70692865656524d541c3412f01bf64
AUDIO_INPUT_DEVICE=2

# ── Seuils des mots de réveil (0-1, plus HAUT = plus strict) ──────────
ACTIVATE_THRESHOLD=0.6        # « Dis Aura »  (réveil)
INTERRUPT_THRESHOLD=0.85      # « Stop Aura » (interruption)

# ── Détection / endpointing (optionnel) ──────────────────────────────
# WAKE_SPEAKER_GATE=0         # 1 = n'active QUE pour la voix enrôlée (instable sur audio court)
# TARGET_ENDPOINTING=1        # 1 = endpointing par locuteur cible ; 0 = énergie/VAD
# TARGET_HANG_S=2.0           # silence (s) de TA voix avant de couper la commande
# TARGET_THRESHOLD=0.30       # seuil locuteur cible local

# ── Comportement (optionnel) ──────────────────────────────────────────
# AMBIENT_ENABLED=1           # 0 = coupe la transcription ambiante permanente
# AURA_BEEP=1                 # 0 = pas de bip « je t'écoute »
# MAX_WASTED=2                # cycles sans réponse avant retour IDLE
