# ═══════════════════════════════════════════════════════════════════
#  Backend DEVICE (Raspberry Pi) — AUCUNE clé API tierce ici.
#  Le device ne parle qu'au backend cloud, qui détient tous les secrets.
#  L'image flashée par le fabricant ne doit contenir aucune valeur sensible :
#  ces variables sont provisionnées à l'appairage, pas en usine.
# ═══════════════════════════════════════════════════════════════════

# URL du backend cloud (proxy vers ElevenLabs / Anthropic / Mistral / Supabase)
CLOUD_BACKEND_URL=https://backend-aura.hallia.ai

# Token d'identité du device — unique par appareil, révocable côté cloud.
# Provisionné à l'appairage (QR / code), JAMAIS baké dans l'image usine.
DEVICE_TOKEN=
